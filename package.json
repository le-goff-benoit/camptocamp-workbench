{
  "name": "openclaw-workbench-local",
  "version": "0.4.0",
  "private": true,
  "description": "Dashboard local Camptocamp pour emails, agenda, projets et releases",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --test tests/*.test.mjs",
    "start": "python3 scripts/manage.py start",
    "status": "python3 scripts/manage.py status",
    "doctor": "python3 scripts/check_requirements.py",
    "test:portable": "python3 scripts/test_portable.py && node --test tests/*.test.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
